lookup StumperPreparation {
	sub f' f @Stumper by f.short;
	sub longs' longs @Stumper by longs.short;
	sub f' f @Uppercase by f.short;
	sub longs' longs @Uppercase by longs.short;
	sub f' f space @Tlike by f.short;
	sub longs' longs space @Tlike by longs.short;
	sub f' f space @Vlike by f.short;
	sub longs' longs space @Vlike by longs.short;
} StumperPreparation;

lookup Stumper {
	sub f' @Stumper by f.short;
	sub longs' @Stumper by longs.short;
	sub f' @Uppercase by f.short;
	sub longs' @Uppercase by longs.short;
	sub f' space @Vlike by f.short;
	sub longs' space @Vlike by longs.short;
	sub f' space @Tlike by f.short;
	sub longs' space @Tlike by longs.short;
} Stumper;


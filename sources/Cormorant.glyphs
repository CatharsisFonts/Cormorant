{
name = "Replace Feature";
value = "calt; lookup Qtail { sub Q' [U u] by Q.long; sub Q' [Umacron umacron] by Q.long; sub Q' [Uacute uacute] by Q.long; sub Q' [A a A.ss01] by Q.long; sub Q' [Amacron amacron] by Q.long; sub Q' [Aacute aacute] by Q.long; sub Q' [E e] by Q.long; sub Q' [Emacron emacron] by Q.long; sub Q' [Eacute eacute] by Q.long; sub Q' [O o] by Q.long; sub Q' [Omacron omacron] by Q.long; sub Q' [Oacute oacute] by Q.long; sub Q' [Y] by Q.long; sub Q' [Ymacron] by Q.long; sub Q' [Yacute] by Q.long; sub Q' [W w V v] by Q.long; sub Q' [Wacute wacute] by Q.long; sub Q' [R r] by Q.long;  sub q' [a amacron aacute e emacron eacute o omacron oacute] by q.long; sub q' [u umacron uacute v w wacute r] by q.long; } Qtail;  lookup Germandbls { sub @Uppercase germandbls' @Uppercase by germandbls.calt; sub @Uppercase @Uppercase germandbls' by germandbls.calt; sub @Uppercase germandbls' space @Uppercase @Uppercase by germandbls.calt; } Germandbls;  lookup UppercaseHyphen { sub @Uppercase hyphen' @Uppercase by hyphen.case; } UppercaseHyphen;  lookup StumperPreparation { sub f' f @Stumper by f.short; sub longs' longs @Stumper by longs.short; sub f' f @Uppercase by f.short; sub longs' longs @Uppercase by longs.short; sub f' f space @Tlike by f.short; sub longs' longs space @Tlike by longs.short; sub f' f space @Vlike by f.short; sub longs' longs space @Vlike by longs.short; } StumperPreparation;  lookup Stumper { sub f' @Stumper by f.short; sub longs' @Stumper by longs.short; sub f' @Uppercase by f.short; sub longs' @Uppercase by longs.short; sub f' space @Vlike by f.short; sub longs' space @Vlike by longs.short; sub f' space @Tlike by f.short; sub longs' space @Tlike by longs.short; } Stumper;  lookup RShort { sub [R Racute Rcaron Rcommaaccent Rdotbelow Rdotbelowmacron Rmacronbelow]' [R Racute Rcaron Rcommaaccent Rdotbelow Rdotbelowmacron Rmacronbelow AE AEacute AEmacron] by [R.short Racute.short Rcaron.short Rcommaaccent.short Rdotbelow.short Rdotbelowmacron.short Rmacronbelow.short]; } RShort;  lookup ClipAscenders { sub [dcaron lcaron] @LeftAscender' by @ClippedAscender; } ClipAscenders; lookup jacute { sub iacute j.loclNLD' by j.acute; sub iacute.sc j.loclNLD.sc' by j.acute.sc; sub Iacute J.loclNLD' by J.acute; } jacute; lookup capJ { sub @Uppercase J' by J.case; sub J' @Uppercase by J.case; } capJ;";
},
